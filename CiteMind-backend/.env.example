# ══════════════════════════════════════════════════════════════════
# CiteMind 后端环境变量示例 —— 复制为 .env 后按需填写
# （IDE 中：Run Configuration → Environment variables 粘贴，或安装 EnvFile 插件引用本文件）
# ══════════════════════════════════════════════════════════════════

# ── PostgreSQL（docker compose 里的 citemind-postgres，需带 pgvector 扩展）──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=citemind_rag
DB_USERNAME=citemind
DB_PASSWORD=change-me

# ── MinIO（docker compose 里的 citemind-minio；不配置则后端自动降级为占位实现）──
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me

# ── Elasticsearch（docker compose 里的 citemind-es，需安装 IK 中文分词插件）──
ES_HOST=localhost
ES_PORT=9200
ES_SCHEME=http

# ── 阿里云百炼 DashScope（qwen-plus 对话 + text-embedding-v3 向量）──
# 注册地址：https://bailian.console.aliyun.com/ → API-KEY 管理 → 创建
DASHSCOPE_API_KEY=your-dashscope-api-key
OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode

# ── JWT 密钥（至少 32 字节；生产环境必须更换）──
CITEMIND_JWT_SECRET=please-change-to-a-random-32byte-secret!
