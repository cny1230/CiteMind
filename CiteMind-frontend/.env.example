# ══════════════════════════════════════════════════════════════════
# CiteMind 前端环境变量示例 —— 复制为 .env 后按需修改
# ══════════════════════════════════════════════════════════════════

# ── 模式一：演示模式（默认） ──
# 启用内置 Mock 数据，零后端即可浏览全部页面（登录可使用任意账号，
# admin / admin123 为管理员账号）。
# VITE_API_BASE_URL=/api
# VITE_USE_MOCK=true

# ── 模式二：联调真实后端 ──
# 前置条件：后端已启动（默认 http://localhost:10001），Vite 代理已就绪。
VITE_API_BASE_URL=/api
VITE_USE_MOCK=false
